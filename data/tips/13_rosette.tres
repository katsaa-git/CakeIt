behavior = 1
stamp = SubResource("Stamp_rosette")
stamp_spacing = 3.8
ring_spacing = 0.3
speed_thinning = 0.0
dwell_growth = 0.35
size_names = PackedStringArray("Small", "Medium", "Large")
