[gd_resource type="Resource" script_class="TipDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/piping/tip_definition.gd" id="1_tip"]
[ext_resource type="Script" path="res://scripts/piping/profiles/round_profile.gd" id="2_profile"]
[ext_resource type="Script" path="res://scripts/piping/stamps/shell_stamp.gd" id="3_stamp"]

[sub_resource type="Resource" id="Profile_bead"]
script = ExtResource("2_profile")
