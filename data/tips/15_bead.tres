twist = 0.0

[resource]
script = ExtResource("1_tip")
id = &"bead"
display_name = "Bead Border"
description = "A round tip squeezed and pulled: a string of glossy beads, each tucking its tail under the next. Click for one pearl-like bead."
sort_order = 42
tags = PackedStringArray("border", "bead", "pearl")
profile = SubResource("Profile_bead")
behavior = 1
stamp = SubResource("Stamp_bead")
stamp_spacing = 1.45
ring_spacing = 0.3
speed_thinning = 0.0
dwell_growth = 0.5
size_names = PackedStringArray("Small", "Medium", "Large")
